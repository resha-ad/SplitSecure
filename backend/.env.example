# Copy to .env and fill in real values. Never commit the real .env file.

NODE_ENV=development
PORT=4000

DATABASE_URL=postgresql://splitsecure:splitsecure@localhost:5432/splitsecure
REDIS_URL=redis://localhost:6379

# 32-byte (base64) secrets - generate with: openssl rand -base64 32
JWT_ACCESS_SECRET=changeme-generate-a-real-32-byte-secret
JWT_REFRESH_SECRET=changeme-generate-a-different-32-byte-secret
JWT_ACCESS_TTL=15d

# 32-byte (base64) key used as the KEK for envelope encryption of PII/receipts
DATA_ENCRYPTION_KEK=changeme-generate-a-real-32-byte-key

CSRF_SECRET=changeme-generate-a-real-32-byte-secret

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

FRONTEND_URL=http://localhost:5173

# Failed-login lockout tuning (per module lecturer guidance: 10-15 attempts)
LOGIN_MAX_ATTEMPTS=10
LOGIN_LOCKOUT_MINUTES=15

# hCaptcha - leave blank to skip verification (a warning is logged
# instead), or use hCaptcha's officially published test secret below to
# exercise the full CAPTCHA UI flow without a real account (always
# passes - swap for a real secret from https://dashboard.hcaptcha.com
# before any real deployment).
HCAPTCHA_SECRET=0x0000000000000000000000000000000000000
